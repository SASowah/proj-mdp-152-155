pipeline {
    agent any

    environment {
        IMAGE_NAME = 'samsow/webcalculator'
        IMAGE_TAG = 'latest'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'project-3', url: 'https://github.com/SASowah/proj-mdp-152-155.git'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Apply deployment and service manifests to the cluster
                    sh 'kubectl apply -f k8s/deployment.yml'
                    sh 'kubectl apply -f k8s/service.yml'
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    // Get pods and services for confirmation
                    sh 'kubectl get pods'
                    sh 'kubectl get svc'
                }
            }
        }
    }
}